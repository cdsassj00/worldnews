{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldnews",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "38b0ce18a5b84fa69ff47b10c6648ad6" }
  ],
  // Workers AI: ANTHROPIC_API_KEY 가 없을 때 AI 분석을 대신 처리한다(별도 키 불필요).
  "ai": { "binding": "AI" },
  "vars": {
    // "vts" = 모의투자 도메인(29443), "prod" = 실전투자 도메인(9443).
    // 사용자 계좌가 실전 전용이므로 "prod". 주문은 아래 스위치들로 여전히 막혀 있다
    // (ORDER_ENABLED=false, ORDER_DRY_RUN=true) — 조회와 검증만 가능한 상태다.
    "KIS_ENV": "prod",
    // 주문 API 전체 스위치. "true" 로 바꾸기 전에는 주문이 거부된다.
    "ORDER_ENABLED": "false",
    // KIS_ENV=prod 상태에서 실제 주문을 내려면 이 값도 "true" 여야 한다(이중 안전장치).
    "ORDER_ALLOW_REAL": "false",
    // 1회 주문 최대 금액(원). 초과 주문은 서버에서 거부.
    // 자동매매의 종목당 한도(AUTO_CAPITAL_KRW × AUTO_MAX_POSITION_PCT = 200만 × 25% = 50만)에 맞춘다.
    // 이보다 낮으면 국내 대형주는 1주 값이 한도를 넘어 아예 매수가 불가능해진다.
    "MAX_ORDER_NOTIONAL_KRW": "500000",
    // "true" 면 인증·한도·TR_ID 검증까지만 하고 실제 주문은 보내지 않는다.
    // 모의투자 계좌 없이 실전 키만 있을 때 위험 없이 전 과정을 점검하는 스위치.
    "ORDER_DRY_RUN": "true",
    // KIS 호출 방식: auto | fetch | socket (9443 포트 차단 환경 대비)
    "KIS_TRANSPORT": "auto",
    // 해외주식 주문·잔고 사용 여부: auto | on | off
    // auto = 모의투자에서는 해외 불가(한투 모의는 국내 위주), 실전에서는 가능
    "KIS_OVERSEAS": "auto",

    /* ── 자동매매 ────────────────────────────────────────
     * "true" 로 바꾸기 전까지는 크론이 돌아도 계획만 세우고 주문은 보내지 않는다.
     * 실제 매매를 시작하려면 AUTOTRADE_ENABLED / ORDER_ENABLED / ORDER_ALLOW_REAL 를 켜고
     * ORDER_DRY_RUN 을 false 로 내려야 한다 — 네 개를 모두 넘어야 돈이 움직인다. */
    "AUTOTRADE_ENABLED": "false",
    // 운용 원금 상한(원). 계좌에 돈이 더 있어도 이 금액 이상은 쓰지 않는다.
    "AUTO_CAPITAL_KRW": "2000000",
    // 한 종목 최대 비중(%)
    "AUTO_MAX_POSITION_PCT": "25",
    // 종목별 손절 / 익절(%)
    "AUTO_STOP_LOSS_PCT": "7",
    "AUTO_TAKE_PROFIT_PCT": "15",
    // 당일 손실이 이 %를 넘으면 그날 신규 매수 정지(손절 매도는 계속 동작)
    "AUTO_DAILY_LOSS_HALT_PCT": "5",
    // 고점 대비 낙폭이 이 %를 넘으면 사람이 해제할 때까지 영구 정지
    "AUTO_MAX_DRAWDOWN_PCT": "20",
    // 목표 수익(원). 도달하면 신규 매수를 멈춘다. 목표를 위해 손실 한도를 풀지는 않는다.
    "AUTO_TARGET_PROFIT_KRW": "1000000",
    "AUTO_MAX_TRADES_PER_DAY": "6",
    "AUTO_MAX_ORDERS_PER_CYCLE": "3",
    "AUTO_MIN_ORDER_KRW": "30000",
    "AUTO_MAX_POSITIONS": "5"
  },
  // 한국 정규장(09:00~15:20 KST = 00:00~06:20 UTC) 평일에 15분마다 사이클을 돈다.
  "triggers": {
    "crons": ["*/15 0-6 * * 1-5"]
  }
  // 시크릿(대시보드/CLI로 등록, 저장소에 커밋하지 않는다):
  //   wrangler secret put KIS_APP_KEY
  //   wrangler secret put KIS_APP_SECRET
  //   wrangler secret put KIS_ACCOUNT        // 예: 12345678-01
  //   wrangler secret put TRADE_TOKEN        // 주문/잔고 API 접근 암호
  //   wrangler secret put ANTHROPIC_API_KEY  // (선택) AI 분석을 Claude로 처리
}
